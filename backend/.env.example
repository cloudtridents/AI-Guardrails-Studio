OPENAI_API_KEY=your-openai-api-key-here

# Guardrail behavior on internal errors (building rails, LLM exceptions):
#   open   = let content pass through on error (default, best for testing)
#   closed = block content on error (safer for production-like testing)
GUARDRAILS_FAIL_MODE=open

# ─── Classifier decision backend ─────────────────────────────────────────────
# Which decision model the local classifier uses:
#   bert     = local DistilBERT zero-shot classifier (default, no extra service)
#   strands  = strands-decider decision model only (requires the server below)
#   combined = run both; a category triggers if EITHER backend crosses its
#              threshold (max score is used)
DECISION_BACKEND=bert

# strands-decider server (only used when DECISION_BACKEND is strands|combined).
# Run it as a separate process:
#   pip install strands-decider
#   strands-decider serve StrandsAgents/strands-decider-2B-qwen3.5-v1-2610 --port 8100
STRANDS_DECIDER_URL=http://localhost:8100
STRANDS_DECIDER_MODEL=strands-decider-2B-qwen3.5-v1-2610
STRANDS_DECIDER_TIMEOUT=30
